{
  "version": 2,
  "builds": [
    {
      "src": "api/serve.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["Lab*/**", "*.pdf", "*.png", "*.md", "*.jpg", "*.jpeg", "*.gif", "*.svg", "*.docx", "*.txt", "*.c", "*.h"]
      }
    }
  ],
  "routes": [
    { "src": "/", "dest": "/api/serve" },
    { "src": "/(.*)", "dest": "/api/serve?path=$1" }
  ]
}
